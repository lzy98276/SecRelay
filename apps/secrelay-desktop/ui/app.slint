// SecRelay 界面。
//
// 控件一律用 Slint 内置的 fluent 风格组件（Button / ComboBox / Slider / Switch /
// LineEdit / ScrollView / GroupBox），本文件只负责布局。
// 布局自己的颜色取 std-widgets 的 `Palette`，它随风格与强调色自动变化。
// 文案由 Rust 注入 Strings，字体注入 UiFont。

import {
    Palette,
    Button,
    ComboBox,
    Slider,
    LineEdit,
    ScrollView,
    GroupBox,
    StandardListView,
} from "std-widgets.slint";

import "../../../assets/fonts/MiSans/MiSans-Light.ttf";
import "../../../assets/fonts/MiSans/MiSans-Regular.ttf";
import "../../../assets/fonts/MiSans/MiSans-Medium.ttf";
import "../../../assets/fonts/MiSans/MiSans-Demibold.ttf";
import "../../../assets/fonts/MiSans/MiSans-Bold.ttf";

export global UiFont {
    in-out property <string> family: "MiSans";
    in-out property <int> weight: 400;
}

export global Strings {
    in property <string> app-title: "SecRelay";
    in property <string> tagline: "";

    in property <string> group-connect: "";
    in property <string> group-see: "";
    in property <string> group-transfer: "";
    in property <string> group-talk: "";
    in property <string> group-system: "";

    in property <string> nav-devices: "";
    in property <string> nav-screen: "";
    in property <string> nav-camera: "";
    in property <string> nav-files: "";
    in property <string> nav-messages: "";
    in property <string> nav-settings: "";

    in property <string> devices-title: "";
    in property <string> devices-empty: "";
    in property <string> devices-hint: "";
    in property <string> session-peer: "";
    in property <string> session-channels: "";
    in property <string> session-capabilities: "";
    in property <string> session-none: "";

    in property <string> action-connect: "";
    in property <string> action-disconnect: "";
    in property <string> action-send: "";
    in property <string> action-preview-start: "";
    in property <string> action-preview-stop: "";
    in property <string> action-open-log-dir: "";

    in property <string> message-placeholder: "";
    in property <string> messages-empty: "";

    in property <string> preview-title: "";
    in property <string> preview-empty: "";
    in property <string> preview-empty-hint: "";
    in property <string> preview-disclaimer: "";

    in property <string> settings-title: "";
    in property <string> settings-appearance: "";
    in property <string> settings-about: "";
    in property <string> about-fonts: "";
    in property <string> about-misans: "";
    in property <string> about-fluent-icons: "";
    in property <string> about-license-hint: "";
    in property <string> settings-language: "";
    in property <string> settings-language-hint: "";
    in property <string> settings-theme: "";
    in property <string> settings-theme-hint: "";
    in property <string> settings-accent: "";
    in property <string> settings-hue: "";
    in property <string> settings-saturation: "";
    in property <string> settings-font: "";
    in property <string> settings-font-hint: "";
    in property <string> settings-font-family: "";
    in property <string> settings-font-weight: "";
    in property <string> settings-diagnostics: "";
    in property <string> settings-log-dir-hint: "";

    in property <string> settings-relay: "";
    in property <string> relay-hint: "";
    in property <string> relay-list: "";
    in property <string> relay-default: "";
    in property <string> relay-add: "";
    in property <string> relay-add-placeholder: "";
    in property <string> relay-add-hint: "";
    in property <string> relay-remove: "";
    in property <string> relay-selected: "";
    in property <string> relay-id-local: "";
    in property <string> relay-id-advertised: "";
    in property <string> relay-id-match: "";
    in property <string> relay-id-mismatch: "";
    in property <string> relay-id-mismatch-hint: "";
    in property <string> relay-id-malformed: "";
    in property <string> relay-probe: "";
    in property <string> relay-probing: "";
    in property <string> relay-reachable: "";
    in property <string> relay-unreachable: "";
    in property <string> relay-turn-ready: "";
    in property <string> relay-turn-missing: "";
    in property <string> relay-not-checked: "";
    in property <string> relay-proto-mismatch: "";
    in property <string> relay-no-active: "";
    in property <string> relay-signaling: "";
    in property <string> relay-current: "";

    in property <string> theme-follow-system: "";
    in property <string> theme-light: "";
    in property <string> theme-dark: "";
    in property <string> accent-follow-system: "";
    in property <string> accent-custom: "";

    in property <string> account-not-logged-in: "";
    in property <string> action-login: "";

    in property <string> not-available-title: "";
    in property <string> not-available-hint: "";
}

export struct ChatMessage {
    text: string,
    outgoing: bool,
}

export struct RelayRow {
    url: string,
    id: string,
    status: string,
    probe: string,
    selected: bool,
    mismatch: bool,
}

export struct RelayDetail {
    label: string,
    value: string,
}

// ───────────────────────────────────────────── 通用块

component PageTitle inherits Text {
    font-size: 22px;
    font-weight: 600;
    color: Palette.foreground;
}

component HintText inherits Text {
    font-size: 12px;
    color: Palette.foreground;
    opacity: 0.7;
    wrap: word-wrap;
}

component FieldRow inherits HorizontalLayout {
    in property <string> label: "";
    in property <string> value: "";
    spacing: 12px;

    Text {
        text: root.label;
        width: 88px;
        font-size: 13px;
        vertical-alignment: center;
        color: Palette.foreground;
        opacity: 0.7;
    }
    Text {
        text: root.value;
        font-size: 13px;
        vertical-alignment: center;
        wrap: word-wrap;
        color: Palette.foreground;
    }
    Rectangle { horizontal-stretch: 1; }
}

/// 设置项：左侧固定宽度的标签 + 右侧控件。
component SettingRow inherits HorizontalLayout {
    in property <string> label: "";
    spacing: 12px;

    Text {
        text: root.label;
        width: 88px;
        font-size: 13px;
        vertical-alignment: center;
        color: Palette.foreground;
    }
    @children
}

// ───────────────────────────────────────────── 页面：设备
component DevicesPage inherits ScrollView {
    in property <bool> connected: false;
    in property <string> state-text: "";
    in property <string> peer-text: "";
    in property <string> channels-text: "";
    in property <string> capabilities-text: "";
    callback toggle-connect();

    VerticalLayout {
        padding: 24px;
        spacing: 16px;
        alignment: start;

        PageTitle { text: Strings.devices-title; }

        GroupBox {
            title: Strings.session-peer;
            VerticalLayout {
                spacing: 8px;
            HorizontalLayout {
                spacing: 16px;
                Text {
                    text: root.state-text;
                    font-size: 15px;
                    font-weight: 600;
                    vertical-alignment: center;
                    color: Palette.accent-background;
                }
                Text {
                    text: root.peer-text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    color: Palette.foreground;
                    opacity: 0.8;
                }
                Button {
                    text: root.connected ? Strings.action-disconnect : Strings.action-connect;
                    primary: !root.connected;
                    clicked => {
                        root.toggle-connect();
                    }
                }
            }
            FieldRow { label: Strings.session-peer; value: root.peer-text; }
            FieldRow { label: Strings.session-channels; value: root.channels-text; }
            FieldRow { label: Strings.session-capabilities; value: root.capabilities-text; }
            }
        }

        GroupBox {
            title: Strings.devices-title;
            VerticalLayout {
                spacing: 8px;
            Text {
                text: Strings.devices-empty;
                horizontal-alignment: center;
                font-size: 14px;
                color: Palette.foreground;
                opacity: 0.8;
            }
            HintText { text: Strings.devices-hint; horizontal-alignment: center; }
            }
        }
    }
}

// ───────────────────────────────────────────── 页面：远程桌面
component ScreenPage inherits VerticalLayout {
    in property <image> preview;
    in property <bool> previewing: false;
    in property <string> preview-stats: "";
    callback toggle-preview();

    padding: 24px;
    spacing: 16px;

    HorizontalLayout {
        spacing: 12px;
        PageTitle { text: Strings.preview-title; vertical-alignment: center; }
        HintText {
            text: root.preview-stats;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    Rectangle {
        vertical-stretch: 1;
        background: Palette.alternate-background;
        border-radius: 6px;
        border-width: 1px;
        border-color: Palette.border;

        if root.previewing : Image {
            source: root.preview;
            image-fit: contain;
        }

        if !root.previewing : VerticalLayout {
            alignment: center;
            spacing: 10px;
            padding: 24px;
            Text {
                text: Strings.preview-empty;
                horizontal-alignment: center;
                font-size: 15px;
                color: Palette.foreground;
            }
            HintText {
                text: Strings.preview-empty-hint;
                horizontal-alignment: center;
            }
        }
    }

    HorizontalLayout {
        spacing: 12px;
        Button {
            text: root.previewing ? Strings.action-preview-stop : Strings.action-preview-start;
            primary: !root.previewing;
            clicked => {
                root.toggle-preview();
            }
        }
        HintText {
            text: Strings.preview-disclaimer;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

component PlaceholderPage inherits VerticalLayout {
    padding: 24px;
    spacing: 10px;
    alignment: center;

    Text {
        text: Strings.not-available-title;
        horizontal-alignment: center;
        font-size: 18px;
        color: Palette.foreground;
    }
    HintText {
        text: Strings.not-available-hint;
        horizontal-alignment: center;
    }
}

// ───────────────────────────────────────────── 页面：消息
component MessagesPage inherits VerticalLayout {
    in property <[ChatMessage]> messages: [];
    in-out property <string> draft: "";
    in property <bool> connected: false;
    callback submit(string);

    padding: 24px;
    spacing: 16px;

    PageTitle { text: Strings.nav-messages; }

    Rectangle {
        vertical-stretch: 1;
        background: Palette.alternate-background;
        border-radius: 6px;
        border-width: 1px;
        border-color: Palette.border;

        if root.messages.length == 0 : Text {
            text: Strings.messages-empty;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: Palette.foreground;
            opacity: 0.7;
        }

        ScrollView {
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                // ScrollView 里必须显式 start，否则子项会被拉伸填满
                alignment: start;

                for message in root.messages : HorizontalLayout {
                    alignment: message.outgoing ? end : start;
                    vertical-stretch: 0;

                    Rectangle {
                        vertical-stretch: 0;
                        background: message.outgoing
                            ? Palette.accent-background
                            : Palette.control-background;
                        border-radius: 8px;
                        max-width: min(root.width * 0.7, 460px);

                        // padding 只对布局元素生效，所以包一层
                        HorizontalLayout {
                            padding: 10px;
                            Text {
                                text: message.text;
                                font-size: 13px;
                                wrap: word-wrap;
                                color: message.outgoing
                                    ? Palette.accent-foreground
                                    : Palette.foreground;
                            }
                        }
                    }
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 12px;
        LineEdit {
            horizontal-stretch: 1;
            placeholder-text: Strings.message-placeholder;
            text <=> root.draft;
            enabled: root.connected;
            accepted => {
                root.submit(root.draft);
            }
        }
        Button {
            text: Strings.action-send;
            primary: true;
            enabled: root.connected;
            clicked => {
                root.submit(root.draft);
            }
        }
    }
}

// ───────────────────────────────────────────── 中继列表

component RelayList inherits VerticalLayout {
    in property <[RelayRow]> rows: [];
    in property <int> current: -1;
    in property <string> remove-text: "";
    in property <string> empty-text: "";
    callback select(int);
    callback remove(string);

    spacing: 1px;

    if root.rows.length == 0 : Text {
        text: root.empty-text;
        font-size: 13px;
        color: Palette.foreground;
        opacity: 0.6;
    }

    for entry[idx] in root.rows : Rectangle {
        min-height: 46px;
        background: idx == root.current
            ? Palette.control-background
            : Palette.alternate-background;

        HorizontalLayout {
            padding: 6px;
            spacing: 8px;

            // 选中态：左侧一条强调色
            Rectangle {
                width: 3px;
                background: idx == root.current ? Palette.accent-background : transparent;
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                horizontal-stretch: 1;

                Text {
                    text: entry.url;
                    font-size: 13px;
                    font-weight: idx == root.current ? 600 : 400;
                    color: Palette.foreground;
                    wrap: no-wrap;
                    overflow: elide;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: entry.status;
                        font-size: 11px;
                        color: Palette.foreground;
                        opacity: entry.mismatch ? 0.85 : 1.0;
                    }
                    Text {
                        text: entry.probe;
                        font-size: 11px;
                        color: Palette.foreground;
                        opacity: 0.6;
                    }
                    Text {
                        text: entry.id;
                        font-size: 11px;
                        color: Palette.foreground;
                        opacity: 0.6;
                    }
                }
            }

            Button {
                text: root.remove-text;
                clicked => {
                    root.remove(entry.url);
                }
            }
        }

        // 点行本身即选中；按钮在上面，点按钮不会走到这里
        TouchArea {
            clicked => {
                root.select(idx);
            }
        }
    }
}

// ───────────────────────────────────────────── 主窗口
export component AppWindow inherits Window {
    title: Strings.app-title;
    width: 1180px;
    height: 780px;
    background: Palette.background;
    default-font-family: UiFont.family;
    default-font-weight: UiFont.weight;

    // 0 设备 / 1 远程桌面 / 2 摄像头 / 3 文件 / 4 消息
    in-out property <int> current-page: 0;

    // 底部账号/设置列表的选中项，点完清回 -1
    in-out property <int> nav-system: -1;

    in property <bool> connected: false;
    in property <string> state-text: "";
    in property <string> peer-text: "";
    in property <string> channels-text: "";
    in property <string> capabilities-text: "";
    in property <image> preview;
    in property <bool> previewing: false;
    in property <string> preview-stats: "";
    in property <[ChatMessage]> messages: [];
    in-out property <string> message-input: "";
    in property <string> language-name: "";
    in property <string> log-dir: "";
    in property <string> account-text: "";
    in property <string> account-subtitle: "";

    callback connect-clicked();
    callback send-clicked(string);
    callback preview-toggle-clicked();
    callback open-log-dir-clicked();
    callback settings-clicked();
    callback login-clicked();

    HorizontalLayout {
        spacing: 0;

        // ══ 左：导航栏
        Rectangle {
            width: 224px;
            background: Palette.alternate-background;

            VerticalLayout {
                padding: 12px;
                spacing: 2px;

                VerticalLayout {
                    height: 48px;
                    spacing: 2px;
                    Text {
                        text: Strings.app-title;
                        font-size: 17px;
                        font-weight: 600;
                        color: Palette.foreground;
                    }
                    Text {
                        text: Strings.tagline;
                        font-size: 10px;
                        color: Palette.foreground;
                        opacity: 0.6;
                    }
                }

                // 导航：一个扁平列表，不放分组小标题。
                // ListView 自带滚动条，这里高度正好等于内容，关掉它免得右边留一条竖线。
                StandardListView {
                    height: 240px;
                    model: [
                        { text: Strings.nav-devices },
                        { text: Strings.nav-screen },
                        { text: Strings.nav-camera },
                        { text: Strings.nav-files },
                        { text: Strings.nav-messages },
                    ];
                    current-item <=> root.current-page;
                }

                // 撑开，把账号与设置推到底部
                Rectangle { vertical-stretch: 1; }

                Rectangle { height: 1px; background: Palette.border; }

                // 这两个是动作不是状态，点完就把选中态清掉
                StandardListView {
                    height: 96px;
                    model: [{ text: root.account-text }, { text: Strings.nav-settings }];
                    current-item <=> root.nav-system;
                    current-item-changed(index) => {
                        if index == 0 {
                            root.login-clicked();
                        } else {
                            root.settings-clicked();
                        }
                        root.nav-system = -1;
                    }
                }
            }
        }

        Rectangle { width: 1px; background: Palette.border; }

        // ══ 右：当前页面
        Rectangle {
            horizontal-stretch: 1;

            DevicesPage {
                visible: root.current-page == 0;
                connected: root.connected;
                state-text: root.state-text;
                peer-text: root.peer-text;
                channels-text: root.channels-text;
                capabilities-text: root.capabilities-text;
                toggle-connect => {
                    root.connect-clicked();
                }
            }
            ScreenPage {
                visible: root.current-page == 1;
                preview: root.preview;
                previewing: root.previewing;
                preview-stats: root.preview-stats;
                toggle-preview => {
                    root.preview-toggle-clicked();
                }
            }
            PlaceholderPage { visible: root.current-page == 2; }
            PlaceholderPage { visible: root.current-page == 3; }
            MessagesPage {
                visible: root.current-page == 4;
                messages: root.messages;
                draft <=> root.message-input;
                connected: root.connected;
                submit(text) => {
                    root.send-clicked(text);
                }
            }
        }
    }
}

// ───────────────────────────────────────────── 设置（独立窗口）
export component SettingsWindow inherits Window {
    title: Strings.app-title;
    width: 1180px;
    height: 780px;
    background: Palette.background;
    default-font-family: UiFont.family;
    default-font-weight: UiFont.weight;

    // 0 外观 / 1 界面语言 / 2 诊断 / 3 关于
    in-out property <int> settings-page: 0;
    in-out property <int> nav-section: 0;

    changed settings-page => {
        root.nav-section = root.settings-page;
    }
    // 0 跟随系统 / 1 浅色 / 2 深色
    in property <int> theme-mode: 0;
    // 0 跟随系统 / 1 自定义
    in property <int> accent-mode: 0;
    in property <float> hue: 28;
    in property <float> saturation: 78;
    in property <color> accent-preview: #f7630c;
    in property <[string]> families: [];
    in property <[string]> weights: [];
    in property <int> family-index: 0;
    in property <int> weight-index: 0;
    in property <[string]> theme-options: [];
    in property <[string]> accent-options: [];
    in property <string> language-name: "";
    in property <string> log-dir: "";
    in property <string> version: "";

    // 中继：列表、当前选中、正在输入的地址与错误提示
    in property <[RelayRow]> relays: [];
    in property <int> relay-index: -1;
    in property <string> relay-current: "";
    in property <string> relay-current-hint: "";
    in property <[RelayDetail]> relay-details: [];
    in-out property <string> relay-input: "";
    in property <string> relay-input-error: "";
    /// 只有选中项真的 ID 不符时才提示
    in property <bool> relay-mismatch: false;

    callback theme-mode-changed(int);
    callback accent-mode-changed(int);
    callback accent-changed(float, float);
    callback family-selected(int);
    callback weight-selected(int);
    callback open-log-dir-clicked();
    callback relay-selected(int);
    callback relay-removed(string);
    callback relay-add-clicked(string);
    callback relay-probe-clicked();

    HorizontalLayout {
        spacing: 0;

        Rectangle {
            width: 224px;
            background: Palette.alternate-background;

            VerticalLayout {
                padding: 12px;
                spacing: 2px;

                Text {
                    text: Strings.settings-title;
                    font-size: 17px;
                    font-weight: 600;
                    height: 48px;
                    vertical-alignment: center;
                    color: Palette.foreground;
                }

                StandardListView {
                    height: 128px;
                    model: [
                        { text: Strings.settings-appearance },
                        { text: Strings.settings-language },
                        { text: Strings.settings-diagnostics },
                        { text: Strings.settings-about },
                    ];
                    current-item <=> root.nav-section;
                    current-item-changed(index) => {
                        root.settings-page = index;
                    }
                }

                Rectangle { vertical-stretch: 1; }
            }
        }

        Rectangle { width: 1px; background: Palette.border; }

        Rectangle {
            horizontal-stretch: 1;

            // ── 外观
            ScrollView {
                visible: root.settings-page == 0;
                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    alignment: start;

                    PageTitle { text: Strings.settings-appearance; }

                    GroupBox {
                        title: Strings.settings-theme;
                        VerticalLayout {
                            spacing: 8px;
                        SettingRow {
                            label: Strings.settings-theme;
                            ComboBox {
                                horizontal-stretch: 1;
                                model: root.theme-options;
                                current-index: root.theme-mode;
                                selected => {
                                    root.theme-mode-changed(self.current-index);
                                }
                            }
                        }
                        HintText { text: Strings.settings-theme-hint; }
                        }
                    }

                    GroupBox {
                        title: Strings.settings-accent;
                        VerticalLayout {
                            spacing: 8px;
                        SettingRow {
                            label: Strings.settings-accent;
                            ComboBox {
                                horizontal-stretch: 1;
                                model: root.accent-options;
                                current-index: root.accent-mode;
                                selected => {
                                    root.accent-mode-changed(self.current-index);
                                }
                            }
                        }

                        // 自定义时才出现色盘
                        if root.accent-mode == 1 : VerticalLayout {
                            spacing: 8px;

                            SettingRow {
                                label: Strings.settings-hue;
                                Slider {
                                    horizontal-stretch: 1;
                                    minimum: 0;
                                    maximum: 360;
                                    value: root.hue;
                                    changed(value) => {
                                        root.accent-changed(value, root.saturation);
                                    }
                                }
                            }
                            SettingRow {
                                label: Strings.settings-saturation;
                                Slider {
                                    horizontal-stretch: 1;
                                    minimum: 0;
                                    maximum: 100;
                                    value: root.saturation;
                                    changed(value) => {
                                        root.accent-changed(root.hue, value);
                                    }
                                }
                            }
                            SettingRow {
                                label: Strings.settings-accent;
                                Rectangle {
                                    width: 120px;
                                    height: 26px;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: Palette.border;
                                    background: root.accent-preview;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                        }
                    }

                    GroupBox {
                        title: Strings.settings-font;
                        VerticalLayout {
                            spacing: 8px;
                        SettingRow {
                            label: Strings.settings-font-family;
                            ComboBox {
                                horizontal-stretch: 1;
                                model: root.families;
                                current-index: root.family-index;
                                selected => {
                                    root.family-selected(self.current-index);
                                }
                            }
                        }
                        SettingRow {
                            label: Strings.settings-font-weight;
                            ComboBox {
                                horizontal-stretch: 1;
                                model: root.weights;
                                current-index: root.weight-index;
                                selected => {
                                    root.weight-selected(self.current-index);
                                }
                            }
                        }
                        HintText { text: Strings.settings-font-hint; }
                        }
                    }
                }
            }

            // ── 界面语言
            ScrollView {
                visible: root.settings-page == 1;
                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    alignment: start;
                    PageTitle { text: Strings.settings-language; }
                    GroupBox {
                        title: Strings.settings-language;
                        VerticalLayout {
                            spacing: 8px;
                        Text {
                            text: root.language-name;
                            font-size: 14px;
                            color: Palette.accent-background;
                        }
                        HintText { text: Strings.settings-language-hint; }
                        }
                    }
                }
            }

            // ── 诊断
            ScrollView {
                visible: root.settings-page == 2;
                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    alignment: start;
                    PageTitle { text: Strings.settings-diagnostics; }

                    // ── 中继
                    GroupBox {
                        title: Strings.settings-relay;
                        VerticalLayout {
                            spacing: 8px;
                            HintText { text: Strings.relay-hint; }

                            Text {
                                text: Strings.relay-current;
                                font-size: 13px;
                                font-weight: 600;
                                color: Palette.foreground;
                            }
                            Text {
                                text: root.relay-current;
                                font-size: 13px;
                                wrap: word-wrap;
                                color: Palette.accent-background;
                            }
                            Text {
                                text: root.relay-current-hint;
                                font-size: 11px;
                                wrap: word-wrap;
                                color: Palette.foreground;
                                opacity: 0.75;
                            }

                            for detail in root.relay-details : FieldRow {
                                label: detail.label;
                                value: detail.value;
                            }

                            HorizontalLayout {
                                spacing: 12px;
                                Button {
                                    text: Strings.relay-probe;
                                    clicked => {
                                        root.relay-probe-clicked();
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }

                            Rectangle { height: 1px; background: Palette.border; }

                            Text {
                                text: Strings.relay-list;
                                font-size: 13px;
                                font-weight: 600;
                                color: Palette.foreground;
                            }
                            RelayList {
                                rows: root.relays;
                                current: root.relay-index;
                                remove-text: Strings.relay-remove;
                                empty-text: Strings.relay-no-active;
                                select(index) => {
                                    root.relay-selected(index);
                                }
                                remove(url) => {
                                    root.relay-removed(url);
                                }
                            }

                            if root.relay-mismatch : HintText { text: Strings.relay-id-mismatch-hint; }

                            Rectangle { height: 1px; background: Palette.border; }

                            HorizontalLayout {
                                spacing: 8px;
                                LineEdit {
                                    horizontal-stretch: 1;
                                    placeholder-text: Strings.relay-add-placeholder;
                                    text <=> root.relay-input;
                                    accepted => {
                                        root.relay-add-clicked(root.relay-input);
                                    }
                                }
                                Button {
                                    text: Strings.relay-add;
                                    primary: true;
                                    clicked => {
                                        root.relay-add-clicked(root.relay-input);
                                    }
                                }
                            }
                            if root.relay-input-error != "" : Text {
                                text: root.relay-input-error;
                                font-size: 11px;
                                wrap: word-wrap;
                                color: Palette.foreground;
                            }
                            HintText { text: Strings.relay-add-hint; }
                        }
                    }

                    GroupBox {
                        title: Strings.settings-diagnostics;
                        VerticalLayout {
                            spacing: 8px;
                        HintText { text: Strings.settings-log-dir-hint; }
                        Text {
                            text: root.log-dir;
                            font-size: 12px;
                            wrap: word-wrap;
                            color: Palette.foreground;
                        }
                        HorizontalLayout {
                            Button {
                                text: Strings.action-open-log-dir;
                                clicked => {
                                    root.open-log-dir-clicked();
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        }
                    }
                }
            }

            // ── 关于
            ScrollView {
                visible: root.settings-page == 3;
                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    alignment: start;
                    PageTitle { text: Strings.settings-about; }
                    GroupBox {
                        title: Strings.about-fonts;
                        VerticalLayout {
                            spacing: 8px;
                        Text {
                            text: Strings.about-misans;
                            font-size: 13px;
                            wrap: word-wrap;
                            color: Palette.foreground;
                        }
                        Text {
                            text: Strings.about-fluent-icons;
                            font-size: 13px;
                            wrap: word-wrap;
                            color: Palette.foreground;
                        }
                        HintText { text: Strings.about-license-hint; }
                        Text {
                            text: root.version;
                            font-size: 12px;
                            color: Palette.foreground;
                            opacity: 0.7;
                        }
                        }
                    }
                }
            }
        }
    }
}